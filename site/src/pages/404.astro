---
// One static 404 serves both languages, so it carries both.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/', ja: 'トップページ', en: 'Home', ico: 'arrow' },
  { href: '/solutions/', ja: 'ソリューション', en: 'Solutions', ico: 'layers' },
  { href: '/technology/', ja: 'テクノロジー（@POP）', en: 'Technology (@POP)', ico: 'nodes' },
  { href: '/news/', ja: 'ニュース', en: 'News', ico: 'bell' },
  { href: '/contact/', ja: 'お問い合わせ', en: 'Contact', ico: 'mail' },
];
---
<Base title="ページが見つかりません / Page not found">
  <section class="nf">
    <div class="wrap nf-inner">
      <p class="nf-code" aria-hidden="true">404</p>
      <div class="nf-text">
        <span class="eyebrow on-dark">Page not found</span>
        <h1 class="h1">ページが見つかりません。</h1>
        <p class="lead">お探しのページは、サイトリニューアルにより移動または削除された可能性があります。</p>
        <p class="nf-en" lang="en">The page you are looking for may have moved during our redesign. <a href="/en/">Go to the English home page →</a></p>
      </div>
      <ul class="nf-links">
        {links.map((l) => (
          <li><a href={l.href}><Icon name={l.ico} /><span><strong>{l.ja}</strong><small lang="en">{l.en}</small></span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
