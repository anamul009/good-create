---
// Illustration for the Secure Device & Web3.0 OS card: a hardened phone whose
// screen shows the OS layer stack with @POP at the core, plus hardware kill switches.
// Pure SVG with presentation attributes (CSP-safe).
---
<svg class="device-art" viewBox="0 0 640 400" preserveAspectRatio="xMaxYMid meet" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="da-bg" cx="72%" cy="50%" r="65%">
      <stop offset="0" stop-color="#22447f" />
      <stop offset="1" stop-color="#060d1c" />
    </radialGradient>
    <radialGradient id="da-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#6a8cff" stop-opacity=".45" />
      <stop offset="1" stop-color="#6a8cff" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="da-edge" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#b9cbff" />
      <stop offset="1" stop-color="#5a74c9" />
    </linearGradient>
    <linearGradient id="da-core" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ff3d9a" />
      <stop offset="1" stop-color="#6a7cff" />
    </linearGradient>
    <pattern id="da-dots" width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.1" fill="#ffffff" fill-opacity=".06" />
    </pattern>
  </defs>
  <circle cx="530" cy="200" r="170" fill="url(#da-glow)" />
  <circle cx="530" cy="200" r="130" fill="none" stroke="#ffffff" stroke-opacity=".07" />
  <circle cx="530" cy="200" r="165" fill="none" stroke="#ffffff" stroke-opacity=".05" stroke-dasharray="2 8" />

  <!-- phone -->
  <g transform="translate(530 190) rotate(-8) scale(.8)">
    <rect x="-78" y="-150" width="156" height="300" rx="26" fill="#0a1730" stroke="url(#da-edge)" stroke-width="3" />
    <rect x="-66" y="-136" width="132" height="272" rx="16" fill="#0f2147" />
    <rect x="-18" y="-144" width="36" height="6" rx="3" fill="#24406f" />
    <!-- side kill switches -->
    <rect x="78" y="-80" width="6" height="34" rx="3" fill="#ff3d9a" />
    <rect x="78" y="-34" width="6" height="22" rx="3" fill="#8fb0ff" />
    <!-- OS layer stack -->
    <g>
      <rect x="-50" y="-96" width="100" height="30" rx="8" fill="#ffffff" fill-opacity=".07" stroke="#ffffff" stroke-opacity=".14" />
      <rect x="-38" y="-85" width="40" height="8" rx="4" fill="#ffffff" fill-opacity=".35" />
      <rect x="-50" y="-56" width="100" height="30" rx="8" fill="#ffffff" fill-opacity=".07" stroke="#ffffff" stroke-opacity=".14" />
      <rect x="-38" y="-45" width="56" height="8" rx="4" fill="#ffffff" fill-opacity=".28" />
      <rect x="-50" y="-16" width="100" height="30" rx="8" fill="#ffffff" fill-opacity=".07" stroke="#ffffff" stroke-opacity=".14" />
      <rect x="-38" y="-5" width="30" height="8" rx="4" fill="#ffffff" fill-opacity=".22" />
      <rect x="-50" y="24" width="100" height="34" rx="9" fill="url(#da-core)" />
      <text x="0" y="46" text-anchor="middle" font-family="Manrope, system-ui, sans-serif" font-size="14" font-weight="800" fill="#ffffff" letter-spacing=".04em">@POP</text>
    </g>
    <!-- shield -->
    <g transform="translate(0 96)">
      <path d="M0 -20 L17 -13 V2 C17 12 9 19 0 22 C-9 19 -17 12 -17 2 V-13 Z" fill="none" stroke="#b9cbff" stroke-width="2.5" stroke-linejoin="round" />
      <path d="M-7 1 L-2 6 L8 -5" fill="none" stroke="#3fd39a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>

  <!-- floating blocked-tracker chips -->
  <g transform="translate(400 84)">
    <rect x="-34" y="-16" width="68" height="32" rx="16" fill="#0c1d3d" stroke="#ffffff" stroke-opacity=".16" />
    <circle cx="-14" cy="0" r="6" fill="none" stroke="#7d8db3" stroke-width="2" />
    <line x1="-20" y1="-6" x2="-8" y2="6" stroke="#ff3d9a" stroke-width="2.4" stroke-linecap="round" />
    <rect x="-2" y="-3" width="24" height="6" rx="3" fill="#ffffff" fill-opacity=".25" />
  </g>
</svg>
