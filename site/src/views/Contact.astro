---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { img } from '../data/images';
import { getLang, localize } from '../i18n';

const lang = getLang(Astro.url);
// Values sent to the backend stay in English so inquiries route the same way in both languages.
const topicValues = ['SecurityTalk', 'Secure device', 'Waravi', 'Halal SNS', 'TSUGITE', '@POP licensing', 'Web services', 'Press / other'];

const T = {
  en: {
    title: 'Contact',
    desc: 'Contact Good Create about SecurityTalk, @POP, Waravi, partnerships or press.',
    h1: 'Tell us what you need.',
    lead: 'Our team reads every inquiry and replies directly, usually within two business days.',
    sideEyebrow: 'Get in touch',
    sideTitle: 'We’re here to help.',
    head: 'Head office (Marugame)',
    pop: '@POP Business Division (Takamatsu)',
    hoursLabel: 'Business hours',
    hours: 'Weekdays 9:00–18:00 JST',
    keys: 'SecurityTalk activation keys',
    secure: 'This form is sent over an encrypted connection and used only to answer your inquiry. No tracking or advertising cookies are used on this site.',
    legend: 'What is your inquiry about?',
    topics: topicValues,
    name: 'Name', org: 'Organization', email: 'Email', phone: 'Phone', message: 'Message',
    hint: 'Please don’t include passwords or confidential details.',
    hp: 'Leave this field empty',
    consent: ['I agree to the handling of my information as described in the ', 'privacy policy', '.'],
    send: 'Send inquiry',
    msgs: {
      name: 'Please enter your name.',
      emailEmpty: 'Please enter your email.',
      emailBad: 'Please enter a valid email address.',
      phone: 'Please use digits, spaces, + ( ) or -.',
      message: 'Please write at least 10 characters.',
      consent: 'Please agree to continue.',
      ok: 'Thank you. Your inquiry has been sent — we will reply soon.',
      fail: 'Sorry, the message could not be sent. Please try again later or call 0877-57-1111.',
    },
  },
  ja: {
    title: 'お問い合わせ',
    desc: 'SecurityTalk、@POP、Waravi、協業、取材などに関するお問い合わせはこちらから。',
    h1: 'お気軽にご相談ください。',
    lead: 'いただいたお問い合わせはすべて担当者が確認し、通常2営業日以内に直接ご回答します。',
    sideEyebrow: 'Get in touch',
    sideTitle: 'お電話でも承ります。',
    head: '丸亀本店',
    pop: '@POP事業本部（高松）',
    hoursLabel: '受付時間',
    hours: '平日 9:00〜18:00',
    keys: 'SecurityTalk アクティベーションキー',
    secure: '本フォームは暗号化通信で送信され、お問い合わせへの回答にのみ利用します。当サイトでは追跡・広告目的のCookieを使用していません。',
    legend: 'お問い合わせ内容',
    topics: ['SecurityTalk', 'セキュア端末', 'Waravi', 'ハラールSNS', 'TSUGITE', '@POP ライセンス', 'WEBサービス', '取材・その他'],
    name: 'お名前', org: '会社名・団体名', email: 'メールアドレス', phone: '電話番号', message: 'お問い合わせ内容',
    hint: 'パスワードや機密情報は記入しないでください。',
    hp: 'この欄は空欄のままにしてください',
    consent: ['', 'プライバシーポリシー', 'に記載の個人情報の取り扱いに同意します。'],
    send: '送信する',
    msgs: {
      name: 'お名前を入力してください。',
      emailEmpty: 'メールアドレスを入力してください。',
      emailBad: '正しいメールアドレスを入力してください。',
      phone: '数字・スペース・+ ( ) - のみ使用できます。',
      message: '10文字以上でご記入ください。',
      consent: '同意のうえ送信してください。',
      ok: 'お問い合わせを受け付けました。担当者よりご連絡いたします。',
      fail: '送信できませんでした。時間をおいて再度お試しいただくか、0877-57-1111 までお電話ください。',
    },
  },
}[lang];
---
<Base title={T.title} description={T.desc}>
  <PageHero image={img.womanPhoneStreet} crumbs={[{ label: T.title }]} eyebrow="Contact" title={T.h1} lead={T.lead} />

  <section class="section section--soft">
    <div class="wrap">
      <div class="split">
        <aside class="contact-side">
          <span class="eyebrow reveal">{T.sideEyebrow}</span>
          <h2 class="h2 reveal">{T.sideTitle}</h2>
          <ul class="contact-list reveal">
            <li><Icon name="phone" /><div><small>{T.head}</small><a href="tel:+81877571111">0877-57-1111</a></div></li>
            <li><Icon name="phone" /><div><small>{T.pop}</small><a href="tel:+81878026757">087-802-6757</a></div></li>
            <li><Icon name="clock" /><div><small>{T.hoursLabel}</small><span>{T.hours}</span></div></li>
            <li><Icon name="key" /><div><small>{T.keys}</small><a href="https://securitytalk.jp/toi/" target="_blank" rel="noopener noreferrer">securitytalk.jp/toi ↗</a></div></li>
          </ul>
          <p class="secure-note reveal"><Icon name="lock" /><span>{T.secure}</span></p>
        </aside>

        <div class="form-card reveal">
          <form class="form" method="post" action="/api/contact" data-contact-form data-messages={JSON.stringify(T.msgs)} novalidate>
            <input type="hidden" name="lang" value={lang} />
            <fieldset class="field pills">
              <legend>{T.legend}</legend>
              {topicValues.map((v, i) => (<label class="pill"><input type="radio" name="topic" value={v} checked={i === 0} /><span>{T.topics[i]}</span></label>))}
            </fieldset>
            <div class="form-row">
              <div class="field">
                <label for="f-name">{T.name}<span class="req">*</span></label>
                <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="e-name" />
                <span class="err" id="e-name" aria-live="polite"></span>
              </div>
              <div class="field">
                <label for="f-org">{T.org}</label>
                <input id="f-org" name="organization" type="text" autocomplete="organization" maxlength="150" />
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="f-email">{T.email}<span class="req">*</span></label>
                <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="e-email" />
                <span class="err" id="e-email" aria-live="polite"></span>
              </div>
              <div class="field">
                <label for="f-tel">{T.phone}</label>
                <input id="f-tel" name="phone" type="tel" autocomplete="tel" maxlength="30" aria-describedby="e-tel" />
                <span class="err" id="e-tel" aria-live="polite"></span>
              </div>
            </div>
            <div class="field">
              <label for="f-msg">{T.message}<span class="req">*</span></label>
              <textarea id="f-msg" name="message" required minlength="10" maxlength="4000" aria-describedby="e-msg h-msg"></textarea>
              <span class="hint" id="h-msg">{T.hint}</span>
              <span class="err" id="e-msg" aria-live="polite"></span>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="f-website">{T.hp}</label>
              <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="field">
              <label class="check"><input type="checkbox" name="consent" required aria-describedby="e-consent" /><span>{T.consent[0]}<a class="inline" href={localize(lang, '/privacy/')}>{T.consent[1]}</a>{T.consent[2]}</span></label>
              <span class="err" id="e-consent" aria-live="polite"></span>
            </div>
            <div class="form-status" role="status" data-form-status></div>
            <div><button class="btn btn--primary" type="submit">{T.send} <Icon name="arrow" /></button></div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
