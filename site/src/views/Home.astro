---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import PopMesh from '../components/PopMesh.astro';
import DeviceArt from '../components/DeviceArt.astro';
import GlobalMap from '../components/GlobalMap.astro';
import heroPoster from '../assets/img/hero-poster.jpg';
import { getContent, formatDate } from '../data/site';
import { img, solutionMedia, creator } from '../data/images';
import type { ImageMetadata } from 'astro';
import { getLang, t, localize } from '../i18n';

const lang = getLang(Astro.url);
const UI = t(lang);
const L = (href: string) => localize(lang, href);
const { patents, recognition, news, solutions, digitalServices } = getContent(lang);

const T = {
  en: {
    heroEyebrow: 'Trust infrastructure for the Web3.0 era',
    heroL1: 'Connecting trust.',
    heroL2: 'Protecting the future.',
    heroLead: 'Good Create develops @POP, a patented technology that keeps personal information on the device instead of the cloud — and builds secure communication, identity and platforms on it.',
    ourSolutions: 'Our solutions',
    aboutPop: 'About @POP',
    news: 'News',
    aboutEyebrow: 'About us',
    aboutTitle: 'Information belongs to the people it describes.',
    aboutLead: 'Every large data breach starts the same way — too much personal information stored in one place. Since 2000, Good Create has built technology that takes a different approach: keep data on each person’s own device, and share only what is needed, when it is needed.',
    aboutImgAlt: 'People walking through a city, each connected by their own device',
    companyInfo: 'Company information',
    message: 'Message from the President',
    figures: [
      { dt: 'Founded', dd: '2000', small: '', note: 'Marugame, Kagawa' },
      { dt: '@POP patents', dd: '4', small: ' countries', note: 'Japan · US · China · Korea' },
      { dt: 'Partner countries', dd: '7', small: '', note: 'MOU & joint ventures' },
      { dt: 'Offices', dd: '3', small: '', note: 'Marugame · Takamatsu · Tokyo' },
    ],
    whyEyebrow: 'Why Good Create',
    whyTitle: 'Built for the moments when trust cannot fail.',
    whyLead: 'Organizations choose Good Create when a data leak is simply not an option. Four things set us apart.',
    pillars: [
      { icon: 'lock', title: 'Private by design', body: 'Personal data stays on each person’s own device. With no central database, there is no single, large target to breach.', proof: 'Patented in Japan, the US, China and Korea' },
      { icon: 'shield', title: 'Proven at national-security level', body: 'Adopted by Japan’s Ministry of Defense and operated by government and defense organizations in several countries.', proof: 'Minister for National Resilience Award 2025' },
      { icon: 'layers', title: 'In-house, end to end', body: 'We plan, develop and operate our own products — from the core protocol to the app in your hand — and answer for every layer.', proof: 'Building software since 2000' },
      { icon: 'globe', title: 'Ready for global markets', body: 'The first ICT product in the world with official halal certification, backed by MOUs and joint ventures with partners abroad.', proof: 'Partners in 7 countries' },
    ],
    bizEyebrow: 'Business',
    bizTitle: 'One philosophy, applied from government security to the living room.',
    bizLead: 'At the heart of every product is @POP — our patented technology that keeps personal data on the device. From that one core, it reaches communication, hardware, daily life, assets and retail.',
    ecoCore: 'Personal Own Protocol',
    ecoTabs: 'Products built on @POP',
    learnMore: 'Learn more',
    creatorTag: 'Your own store app — no code required.',
    creatorPoints: ['8 industry templates', 'Booking, coupons, stamps and EC built in', 'Operations can be fully outsourced'],
    digitalMore: 'Web production & marketing',
    allSolutions: 'All solutions',
    digital: 'Digital services',
    digitalDesc: 'No-code apps, web production and marketing for businesses.',
    techEyebrow: 'Technology',
    techTitle: ['@POP — Your data.', 'Your device.'],
    techLead: 'Personal Own Protocol is a lightweight alternative to blockchain. Devices themselves form the network, so there is no central database of personal information to steal — and almost no infrastructure cost.',
    techBtn: 'Explore the technology',
    techImgAlt: 'Diagram: devices connect directly to each other, with no central database server. Your data stays locked on your own device.',
    recEyebrow: 'Recognition',
    recTitle: 'Trusted where confidentiality is not optional.',
    recImgAlt: 'Good Create receiving the inaugural Minister for National Resilience Award',
    recCaption: '11th Japan Resilience Award 2025 — award ceremony',
    newsTitle: 'News & topics',
    newsAll: 'View all news',
  },
  ja: {
    heroEyebrow: 'Web3.0時代の信頼インフラ',
    heroL1: '信頼をつなぎ、',
    heroL2: '未来を守る。',
    heroLead: 'グッドクリエイトは、個人情報をクラウドではなく端末に保持する特許技術「@POP」を開発し、その上にセキュアな通信・本人認証・プラットフォームを築いています。',
    ourSolutions: 'ソリューション',
    aboutPop: '@POP について',
    news: 'News',
    aboutEyebrow: 'About us',
    aboutTitle: '自分の情報は、自分の手元に。',
    aboutLead: '大規模な情報漏えいの多くは、膨大な個人情報が一か所に集まっていることから始まります。グッドクリエイトは2000年の創業以来、異なるアプローチの技術をつくってきました。情報は一人ひとりの端末に置き、必要なときに、必要なものだけを共有する。',
    aboutImgAlt: 'それぞれの端末でつながりながら街を歩く人々',
    companyInfo: '企業情報',
    message: '代表挨拶',
    figures: [
      { dt: '創業', dd: '2000', small: '年', note: '香川県丸亀市' },
      { dt: '@POP 特許', dd: '4', small: 'か国', note: '日本 · 米国 · 中国 · 韓国' },
      { dt: 'パートナー国', dd: '7', small: 'か国', note: 'MOU・合弁事業' },
      { dt: '拠点', dd: '3', small: '拠点', note: '丸亀 · 高松 · 東京' },
    ],
    whyEyebrow: 'Why Good Create',
    whyTitle: '信頼が揺らいではならない場面のために。',
    whyLead: '情報漏えいが許されない組織が、グッドクリエイトを選ぶ4つの理由。',
    pillars: [
      { icon: 'lock', title: '設計から守るプライバシー', body: '個人情報は一人ひとりの端末に保管。中央データベースを持たないため、大規模な漏えいの標的そのものが存在しません。', proof: '日本・米国・中国・韓国で特許取得' },
      { icon: 'shield', title: '国家レベルの実績', body: '防衛省で採用されるほか、複数の国の政府機関・国防組織で導入・運用されています。', proof: '初代 国土強靱化大臣賞（2025）' },
      { icon: 'layers', title: '自社一貫の開発体制', body: '基盤プロトコルから手元のアプリまで、企画・開発・運用をすべて自社で。すべての層に責任を持ちます。', proof: '2000年創業のソフトウェア開発' },
      { icon: 'globe', title: '世界市場への展開', body: 'IT分野で世界初の公式ハラール認証を取得。海外パートナーとのMOU・合弁事業で展開しています。', proof: '7か国のパートナー' },
    ],
    bizEyebrow: 'Business',
    bizTitle: 'ひとつの思想を、政府のセキュリティからリビングまで。',
    bizLead: 'すべての製品の中心にあるのは、個人情報を端末に置く特許技術 @POP。ひとつの基盤から、通信・端末・暮らし・資産・店舗へと広がっています。',
    ecoCore: 'Personal Own Protocol',
    ecoTabs: '@POP を基盤とする製品',
    learnMore: '詳しく見る',
    creatorTag: '自社の店舗アプリを、ノーコードで。',
    creatorPoints: ['8種類の業種別テンプレート', '予約・クーポン・スタンプ・ECを標準搭載', '運用代行にも対応'],
    digitalMore: 'ホームページ制作・WEBマーケティング',
    allSolutions: 'ソリューション一覧',
    digital: 'デジタルサービス',
    digitalDesc: 'ノーコードアプリ、ホームページ制作、WEBマーケティング。',
    techEyebrow: 'Technology',
    techTitle: ['@POP — あなたのデータを、', 'あなたの端末に。'],
    techLead: 'Personal Own Protocol は、ブロックチェーンに代わる軽量な仕組みです。端末そのものがネットワークを構成するため、盗まれる個人情報の中央データベースが存在せず、インフラコストもほとんどかかりません。',
    techBtn: 'テクノロジーを詳しく見る',
    techImgAlt: '図：端末同士が直接つながり、中央のデータベースサーバーは存在しない。データは自分の端末に保管される。',
    recEyebrow: 'Recognition',
    recTitle: '機密性が求められる現場で、信頼されています。',
    recImgAlt: '初代国土強靱化大臣賞を受賞するグッドクリエイト',
    recCaption: '第11回ジャパン・レジリエンス・アワード 2025 授賞式',
    newsTitle: 'ニュース',
    newsAll: 'ニュース一覧',
  },
}[lang];


// Global presence + President's message (copy reuses facts already on the site)
const G = {
  en: {
    globalEyebrow: 'Global',
    globalTitle: 'From Japan to the world.',
    globalLead: 'Developed in Kagawa, our platforms are expanding overseas through MOUs and joint ventures with partners in seven countries.',
    mapAlt: 'Map: lines connect Japan to partner countries — Poland, Uzbekistan, Pakistan, Saudi Arabia, the UAE, Bangladesh and Indonesia.',
    homeLabel: 'Japan (HQ)',
    homeNote: 'Head office in Kagawa, office in Tokyo',
    partnersLabel: 'MOU & joint-venture partners',
    names: ['Poland', 'Uzbekistan', 'Pakistan', 'Saudi Arabia', 'UAE', 'Bangladesh', 'Indonesia'],
    msgEyebrow: 'Message',
    quote: '“Value every connection between people. Everything we do is for our customers.”',
    excerpt: 'Our first mission is to deliver what our customers need — quickly. Built on the connections we have made and teamwork second to none, we promise to keep evolving for our customers.',
    role: 'Representative Director & President',
    name: 'Masahiro Yamamoto',
    readMore: 'Read the full message',
  },
  ja: {
    globalEyebrow: 'Global',
    globalTitle: '日本から、世界へ。',
    globalLead: '香川で生まれた技術とプラットフォームを、7か国のパートナーとのMOU・合弁事業を通じて海外へ展開しています。',
    mapAlt: '地図：日本からポーランド、ウズベキスタン、パキスタン、サウジアラビア、UAE、バングラデシュ、インドネシアのパートナー国へ線がつながっている',
    homeLabel: '日本（本社）',
    homeNote: '香川本社・東京本社',
    partnersLabel: 'MOU・合弁のパートナー国',
    names: ['ポーランド', 'ウズベキスタン', 'パキスタン', 'サウジアラビア', 'UAE', 'バングラデシュ', 'インドネシア'],
    msgEyebrow: 'Message',
    quote: '人と人のつながりを大切に。すべてはお客様のために。',
    excerpt: 'お客様のニーズにあったものをいち早くご提供することが、我々の一番のミッションです。今までに出会った人と人とのつながりと、どこにも負けないチームワークを財産に、これからもお客様のために進化し続けることを約束します。',
    role: '代表取締役社長',
    name: '山本 真大',
    readMore: '代表挨拶を読む',
  },
}[lang];
type Lbl = { dx: number; dy: number; anchor: 'start' | 'middle' | 'end' };
const coords: [number, number, Lbl][] = [
  [52.2, 21.0, { dx: 0, dy: -30, anchor: 'middle' }],   // Warsaw
  [41.3, 69.2, { dx: 0, dy: -30, anchor: 'middle' }],   // Tashkent
  [33.7, 73.1, { dx: 24, dy: 10, anchor: 'start' }],    // Islamabad
  [24.7, 46.7, { dx: -24, dy: 10, anchor: 'end' }],     // Riyadh
  [24.5, 54.4, { dx: 0, dy: 46, anchor: 'middle' }],    // Abu Dhabi
  [23.8, 90.4, { dx: 0, dy: 46, anchor: 'middle' }],    // Dhaka
  [-6.2, 106.8, { dx: 24, dy: 10, anchor: 'start' }],   // Jakarta
];
const partners = coords.map(([lat, lon, label], i) => ({ name: G.names[i], lat, lon, label }));
const home = { name: G.homeLabel, lat: 34.3, lon: 134.0, label: { dx: 0, dy: 64, anchor: 'middle' as const } };

const poster = await getImage({ src: heroPoster, format: 'webp', width: 1280 });
const latest = [...news].sort((a, b) => b.date.localeCompare(a.date))[0];
// The hero news bar shows the latest item for 30 days (Japan time), counted from its date
// or from NEWS_COUNT_FROM, whichever is later (so the current item gets a month from launch).
// Left out at build time once expired; site.js also hides it on day 31 without a rebuild.
const NEWS_DAYS = 30;
const NEWS_COUNT_FROM = '2026-11-10';
const newsStart = latest ? (latest.date > NEWS_COUNT_FROM ? latest.date : NEWS_COUNT_FROM) : null;
const newsExpires = newsStart ? new Date(Date.parse(`${newsStart}T00:00:00+09:00`) + NEWS_DAYS * 864e5) : null;
const showNews = !!newsExpires && Date.now() < newsExpires.getTime();
const bySlug = (slug: string) => solutions.find((s) => s.slug === slug)!;
const short: Record<string, { en: string; ja: string }> = {
  'secure-device': { en: 'Secure Device', ja: 'セキュア端末' },
  'halal-sns': { en: 'Halal SNS', ja: 'ハラールSNS' },
};
type EcoItem = { key: string; name: string; label: string; cat: string; tagline: string; summary: string; points: string[]; href: string; icon: string; status?: string; image?: ImageMetadata; art?: boolean; extra?: { label: string; href: string } };
const fromSolution = (slug: string, icon: string): EcoItem => {
  const s = bySlug(slug);
  return {
    key: slug, name: s.name, label: short[slug]?.[lang] ?? s.name, cat: s.category, tagline: s.tagline, summary: s.summary,
    points: s.highlights.slice(0, 3).map((h) => h.title), href: `/solutions/${slug}/`, icon, status: s.status,
    image: slug === 'secure-device' ? undefined : solutionMedia[slug].feature, art: slug === 'secure-device',
  };
};
// Display order
const eco: EcoItem[] = [
  fromSolution('securitytalk', 'lock'),
  fromSolution('secure-device', 'device'),
  fromSolution('waravi', 'tv'),
  fromSolution('halal-sns', 'users'),
  fromSolution('tsugite', 'key'),
  {
    key: 'atcreator', name: '@CREATOR', label: '@CREATOR', cat: T.digital, tagline: T.creatorTag, summary: digitalServices[0].body, points: T.creatorPoints,
    href: '/solutions/atcreator/', icon: 'layers', image: creator.hero, extra: { label: T.digitalMore, href: '/solutions/#digital' },
  },
];
---
<Base>
  <!-- ═══ Hero ═══ -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <video data-hero-video autoplay muted loop playsinline preload="metadata" poster={poster.src}>
        <source src="/media/hero.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-shade"></div>
    <div class="wrap hero-inner">
      <span class="eyebrow reveal">{T.heroEyebrow}</span>
      <h1 id="hero-title" class="h-hero reveal">{T.heroL1}<br /><span class="grad-text">{T.heroL2}</span></h1>
      <p class="lead reveal">{T.heroLead}</p>
      <div class="btn-row reveal">
        <a class="btn btn--primary" href={L('/solutions/')}>{T.ourSolutions} <Icon name="arrow" /></a>
        <a class="btn btn--glass" href={L('/technology/')}>{T.aboutPop}</a>
      </div>
    </div>
    {showNews && (
      <div class="hero-news" data-expires={newsExpires!.toISOString()}>
        <div class="wrap">
          <a class="hero-news-link" href={L(`/news/${latest.slug}/`)}>
            <span class="hero-news-label">{T.news}</span>
            <time datetime={latest.date}>{formatDate(latest.date)}</time>
            <span class="hero-news-tag">{latest.tag}</span>
            <span class="hero-news-title">{latest.title}</span>
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    )}
  </section>

  <!-- ═══ 01 About ═══ -->
  <section class="section about2" aria-labelledby="about-title">
    <div class="wrap">
      <div class="about2-head">
        <div>
          <span class="eyebrow reveal"><b>01</b>{T.aboutEyebrow}</span>
          <h2 id="about-title" class="about2-title reveal">{T.aboutTitle}</h2>
        </div>
        <div class="about2-body">
          <p class="lead reveal">{T.aboutLead}</p>
          <div class="btn-row reveal">
            <a class="btn btn--dark" href={L('/company/')}>{T.companyInfo} <Icon name="arrow" /></a>
            <a class="btn btn--outline" href={L('/company/#message')}>{T.message}</a>
          </div>
        </div>
      </div>
      <div class="about2-band">
        <div class="about2-photo reveal">
          <div class="media"><Picture src={img.crowdCity} alt={T.aboutImgAlt} formats={['avif', 'webp']} widths={[640, 1100, 1600, 2000]} sizes="(min-width: 1360px) 1300px, 100vw" /></div>
        </div>
        <dl class="about2-figs reveal">
          {T.figures.map((f) => <div><dt>{f.dt}</dt><dd>{f.dd}{f.small && <small>{f.small}</small>}</dd><span>{f.note}</span></div>)}
        </dl>
      </div>
    </div>
  </section>

  <!-- ═══ 02 Why Good Create ═══ -->
  <section class="section section--dark why" aria-labelledby="why-title">
    <div class="wrap">
      <div class="head why-head">
        <span class="eyebrow reveal"><b>02</b>{T.whyEyebrow}</span>
        <h2 id="why-title" class="h2 reveal">{T.whyTitle}</h2>
        <p class="lead reveal">{T.whyLead}</p>
      </div>
      <ol class="pillars">
        {T.pillars.map((p, i) => (
          <li class="pillar reveal">
            <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="pillar-ico"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <span class="pillar-proof"><Icon name="check" />{p.proof}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 03 Business — editorial rows ═══ -->
  <section class="section section--soft" aria-labelledby="biz-title">
    <div class="wrap">
      <div class="head-row">
        <div class="head">
          <span class="eyebrow reveal"><b>03</b>{T.bizEyebrow}</span>
          <h2 id="biz-title" class="h2 reveal">{T.bizTitle}</h2>
          <p class="lead reveal">{T.bizLead}</p>
        </div>
        <a class="btn btn--outline reveal" href={L('/solutions/')}>{T.allSolutions} <Icon name="arrow" /></a>
      </div>

      <div class="ed-rows">
        {eco.slice(0, 4).map((p, i) => (
          <article class:list={['ed-row', i % 2 === 1 && 'ed-row--flip', `ed--${p.key}`]}>
            <a class="ed-media reveal" href={L(p.href)} tabindex="-1" aria-hidden="true">
              {p.art ? <DeviceArt /> : p.image && <Picture src={p.image} alt="" formats={['avif', 'webp']} widths={[600, 900, 1200]} sizes="(min-width: 960px) 50vw, 100vw" />}
              {p.status && <span class="ed-badge">{p.status}</span>}
            </a>
            <div class="ed-body reveal">
              <div class="ed-meta"><span class="ed-num">{String(i + 1).padStart(2, '0')}</span><span class="ed-cat">{p.cat}</span></div>
              <h3>{p.name}</h3>
              <p class="ed-tag">{p.tagline}</p>
              <p class="ed-sum">{p.summary}</p>
              <ul class="ed-points">{p.points.map((pt) => <li><Icon name="check" />{pt}</li>)}</ul>
              <a class="link ed-link" href={L(p.href)}>{T.learnMore} <Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>

      <div class="ed-pair">
        {eco.slice(4).map((p, i) => (
          <article class:list={['ed-mini', 'reveal', `ed--${p.key}`]}>
            <a class="ed-media ed-media--mini" href={L(p.href)} tabindex="-1" aria-hidden="true">
              {p.image && <Picture src={p.image} alt="" formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 960px) 25vw, 100vw" />}
              {p.status && <span class="ed-badge">{p.status}</span>}
            </a>
            <div class="ed-body">
              <div class="ed-meta"><span class="ed-num">{String(i + 5).padStart(2, '0')}</span><span class="ed-cat">{p.cat}</span></div>
              <h3>{p.name}</h3>
              <p class="ed-tag">{p.tagline}</p>
              <div class="ed-links">
                <a class="link ed-link" href={L(p.href)}>{T.learnMore} <Icon name="arrow" /></a>
                {p.extra && <a class="link ed-link ed-link--sub" href={L(p.extra.href)}>{p.extra.label} <Icon name="arrow" /></a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 04 Technology ═══ -->
  <section class="section pop-band" aria-labelledby="pop-title">
    <div class="wrap">
      <div class="split split--center split--even">
        <div>
          <span class="eyebrow reveal"><b>04</b>{T.techEyebrow}</span>
          <h2 id="pop-title" class="h2 reveal">{T.techTitle[0]}<br />{T.techTitle[1]}</h2>
          <p class="lead reveal">{T.techLead}</p>
          <ul class="patent-list reveal">
            {patents.map((p) => <li><b>{p.code}</b><em>{p.region}</em><span>{p.number}</span></li>)}
          </ul>
          <div class="reveal"><a class="btn btn--dark" href={L('/technology/')}>{T.techBtn} <Icon name="arrow" /></a></div>
        </div>
        <div class="reveal">
          <div class="media pop-media">
            <PopMesh label={T.techImgAlt} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 05 Global ═══ -->
  <section class="section gmap" aria-labelledby="global-title">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow reveal"><b>05</b>{G.globalEyebrow}</span>
        <h2 id="global-title" class="h2 reveal">{G.globalTitle}</h2>
        <p class="lead reveal">{G.globalLead}</p>
      </div>
      <div class="gmap-media reveal"><GlobalMap label={G.mapAlt} home={home} partners={partners} /></div>
      <div class="gmap-legend reveal">
        <div><span class="gmap-dot gmap-dot--home"></span><div><strong>{G.homeLabel}</strong><small>{G.homeNote}</small></div></div>
        <div><span class="gmap-dot"></span><div><strong>{G.partnersLabel}</strong><ul>{G.names.map((n) => <li>{n}</li>)}</ul></div></div>
      </div>
    </div>
  </section>

  <!-- ═══ 06 Recognition ═══ -->
  <section class="section section--dark" aria-labelledby="rec-title">
    <div class="wrap">
      <div class="recog-grid">
        <div class="reveal">
          <div class="media">
            <Picture src={img.awardCeremony} alt={T.recImgAlt} formats={['avif', 'webp']} widths={[480, 800, 1000]} sizes="(min-width: 960px) 50vw, 100vw" />
          </div>
          <p class="media-caption">{T.recCaption}</p>
        </div>
        <div>
          <span class="eyebrow reveal"><b>06</b>{T.recEyebrow}</span>
          <h2 id="rec-title" class="h2 reveal recog-title">{T.recTitle}</h2>
          <ul class="recog-list reveal">
            {recognition.map((r) => <li><span class="yr">{r.year}</span><h3>{r.title}</h3><p>{r.body}</p></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 07 Message ═══ -->
  <section class="section section--soft msg-strip" aria-labelledby="msg-title">
    <div class="wrap msg-strip-grid">
      <span class="eyebrow reveal"><b>07</b>{G.msgEyebrow}</span>
      <div>
        <h2 id="msg-title" class="msg-quote reveal">{G.quote}</h2>
        <p class="msg-excerpt reveal">{G.excerpt}</p>
        <div class="msg-foot reveal">
          <p class="msg-sign"><small>{G.role}</small>{G.name}</p>
          <a class="link" href={L('/company/#message')}>{G.readMore} <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 08 News ═══ -->
  <section class="section" aria-labelledby="news-title">
    <div class="wrap">
      <div class="news-grid">
        <div class="head">
          <span class="eyebrow reveal"><b>08</b>{T.news}</span>
          <h2 id="news-title" class="h2 reveal">{T.newsTitle}</h2>
          <a class="btn btn--outline reveal news-all" href={L('/news/')}>{T.newsAll} <Icon name="arrow" /></a>
        </div>
        <ul class="news-list reveal">
          {news.map((n) => (
            <li>
              <a href={L(`/news/${n.slug}/`)}>
                <time datetime={n.date}>{formatDate(n.date)}</time>
                <span class="news-tag">{n.tag}</span>
                <span class="news-title">{n.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Cta />
</Base>
