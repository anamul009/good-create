---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
// DRAFT: both versions to be reviewed by legal counsel against the current Japanese policy (APPI).
const T = {
  en: {
    title: 'Privacy policy',
    desc: 'How Good Create handles personal information.',
    lead: 'Collect as little as possible, keep it no longer than necessary — the same principle behind @POP applies to this website.',
    sections: [
      ['1. Information we collect', 'When you contact us, we collect the details you choose to provide: your name, organization, email address, phone number and message. We do not use advertising or tracking cookies, analytics scripts or third-party embeds on this website.'],
      ['2. How we use it', ['To respond to your inquiry and provide information you request', 'To deliver and support contracted products and services', 'To comply with legal obligations']],
      ['3. Sharing', 'We do not sell personal information. We share it with third parties only with your consent, where required by law, or with service providers bound by confidentiality obligations.'],
      ['4. Security', 'We apply organizational and technical safeguards, including encrypted connections and access restriction, to prevent loss, misuse or unauthorized access.'],
      ['5. Your rights', 'You may request disclosure, correction, suspension of use or deletion of your personal information by contacting us.'],
    ] as [string, string | string[]][],
    contactTitle: '6. Contact',
    contact: ['Good Create Co., Ltd.', '346-3 Okadashimo, Ayauta-cho, Marugame, Kagawa 761-2402, Japan', 'Tel 0877-57-1111'],
  },
  ja: {
    title: 'プライバシーポリシー',
    desc: '株式会社グッドクリエイトにおける個人情報の取り扱いについて。',
    lead: '必要以上に集めず、必要以上に持たない。@POP と同じ考え方を、このウェブサイトにも適用しています。',
    sections: [
      ['1. 取得する情報', 'お問い合わせの際に、お客様がご提供くださる情報（お名前、会社名・団体名、メールアドレス、電話番号、お問い合わせ内容）を取得します。当サイトでは、広告・追跡目的のCookie、アクセス解析スクリプト、第三者の埋め込みコンテンツを使用していません。'],
      ['2. 利用目的', ['お問い合わせへの回答および、ご依頼いただいた情報の提供', 'ご契約いただいた製品・サービスの提供およびサポート', '法令上の義務の履行']],
      ['3. 第三者提供', '当社は個人情報を販売しません。ご本人の同意がある場合、法令に基づく場合、または守秘義務を負う委託先に業務を委託する場合を除き、第三者に提供しません。'],
      ['4. 安全管理', '暗号化通信やアクセス制限を含む組織的・技術的な安全管理措置を講じ、個人情報の漏えい、滅失、不正アクセスの防止に努めます。'],
      ['5. 開示等のご請求', 'ご本人からの個人情報の開示、訂正、利用停止、削除のご請求には、下記窓口にて対応します。'],
    ] as [string, string | string[]][],
    contactTitle: '6. お問い合わせ窓口',
    contact: ['株式会社グッドクリエイト', '〒761-2402 香川県丸亀市綾歌町岡田下346-3', 'TEL 0877-57-1111'],
  },
}[lang];
---
<Base title={T.title} description={T.desc}>
  <PageHero crumbs={[{ label: T.title }]} eyebrow="Legal" title={T.title} lead={T.lead} />
  <section class="section">
    <div class="wrap">
      <div class="prose">
        {T.sections.map(([h, body]) => (
          <>
            <h2>{h}</h2>
            {Array.isArray(body) ? <ul>{body.map((li) => <li>{li}</li>)}</ul> : <p>{body}</p>}
          </>
        ))}
        <h2>{T.contactTitle}</h2>
        <p>{T.contact.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
      </div>
    </div>
  </section>
</Base>
